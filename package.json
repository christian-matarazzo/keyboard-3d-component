{
  "name": "keyboard-composer",
  "version": "0.1.0",
  "type": "module",
  "description": "Configuratore 3D di tastiere: navigazione su grafo di pose, rig di luci per posa e sequencer di animazioni autorate",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist/lib",
    "public/models",
    "public/draco",
    "public/lightconfig"
  ],
  "exports": {
    ".": {
      "import": "./dist/lib/keyboard-composer.js",
      "default": "./dist/lib/keyboard-composer.js"
    },
    "./style.css": "./dist/lib/keyboard-composer.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:lib": "vite build --mode lib",
    "preview": "vite preview",
    "asset:convert": "node --max-old-space-size=8192 node_modules/obj2gltf/bin/obj2gltf.js -i assets-src/Array_L_WEB_Retopo.obj -o assets-src/keyboard-raw.glb",
    "asset:optimize": "gltf-transform weld assets-src/keyboard-raw.glb assets-src/kb-1.glb && gltf-transform prune assets-src/kb-1.glb assets-src/kb-2.glb --keep-attributes && gltf-transform draco assets-src/kb-2.glb public/models/keyboard.glb --quantize-normal 12 --quantize-position 14",
    "asset:inspect": "gltf-transform inspect public/models/keyboard.glb",
    "asset:ar": "node scripts/make-ar-asset.mjs"
  },
  "peerDependencies": {
    "@react-three/drei": "^10.0.0",
    "@react-three/fiber": "^9.0.0",
    "leva": "^0.10.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.178.0"
  },
  "peerDependenciesMeta": {
    "leva": {
      "optional": true
    }
  },
  "dependencies": {
    "maath": "^0.10.8"
  },
  "devDependencies": {
    "@gltf-transform/cli": "^4.0.0",
    "@react-three/drei": "^10.0.0",
    "@react-three/fiber": "^9.0.0",
    "@vitejs/plugin-react": "^4.4.0",
    "leva": "^0.10.1",
    "obj2gltf": "^3.1.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.178.0",
    "vite": "^6.0.0"
  }
}
